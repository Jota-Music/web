---
import { ArrowRight } from "lucide-astro";
import type { Phrase, Ref } from "@/i18n/landing/schema";

interface Props {
	value: Phrase;
	links?: Partial<Record<Ref, string>>;
	code?: string;
	link?: string;
	arrows?: Ref[];
}

const { value, links = {}, code = "text-zinc-300", link = "", arrows = [] } = Astro.props;
---

{
	typeof value === "string" ? (
		value
	) : (
		value.map((part) =>
			typeof part === "string" ? (
				part
			) : "code" in part ? (
				<code class={code}>{part.code}</code>
			) : (
				<a href={links[part.link]} rel="noreferrer" class={link}>
					{part.label}
					{arrows.includes(part.link) && <ArrowRight size={12} aria-hidden="true" />}
				</a>
			),
		)
	)
}
