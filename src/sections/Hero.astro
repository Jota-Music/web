---
import { CloudOff, Code, CreditCard, Download, EyeOff, Github } from "lucide-astro";

const promises = [
	{ icon: CloudOff, label: "No cloud" },
	{ icon: EyeOff, label: "No tracking" },
	{ icon: CreditCard, label: "No subscriptions" },
	{ icon: Code, label: "Open source" },
];

const version = await fetch("https://api.github.com/repos/Jota-Music/jota/releases/latest")
	.then((r) => r.ok && r.json())
	.then((d) => d?.tag_name?.replace(/^v/, "") ?? "latest")
	.catch(() => "latest");
---

<section id="top" class="relative scroll-mt-28">
	<div class="hero-bloom pointer-events-none absolute inset-x-0 top-0 h-[26rem]"></div>
	<div
		class="relative mx-auto grid w-full max-w-6xl gap-10 px-4 pt-24 pb-32 sm:px-6 md:grid-cols-12 md:items-center md:gap-8 md:pt-28 md:pb-44"
	>
		<div class="min-w-0 md:col-span-7">
			<p
				class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-surface/60 px-3 py-1 text-xs text-muted"
			>
				<span class="size-1.5 rounded-full bg-accent"></span>
				Self-hosted music streaming
			</p>
			<h1
				class="mt-5 text-4xl font-bold tracking-tight text-balance [overflow-wrap:anywhere] sm:text-5xl lg:text-6xl"
			>
				Your music, your rules.
			</h1>
			<p class="mt-5 max-w-xl text-base leading-relaxed text-balance text-muted sm:text-lg">
				A self-hosted music streaming app for desktop and mobile. Browse
				Spotify, play the audio through YouTube, and start a room over a relay
				you own.
			</p>
			<ul class="mt-6 flex flex-wrap gap-2">
				{
					promises.map(({ icon: Icon, label }) => (
						<li class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-surface/60 px-3 py-1.5 text-xs text-zinc-300">
							<Icon size={13} aria-hidden="true" class="text-accent" />
							{label}
						</li>
					))
				}
			</ul>
			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="https://github.com/Jota-Music/jota/releases/latest"
					rel="noreferrer"
					class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-transform hover:-translate-y-px"
				>
					<Download size={16} aria-hidden="true" />
					Download Jota {version}
				</a>
				<a
					href="https://github.com/Jota-Music/jota"
					rel="noreferrer"
					class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border border-white/10 bg-surface px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:bg-raised"
				>
					<Github size={16} aria-hidden="true" />
					View source
				</a>
			</div>
			<p class="mt-4 text-xs text-balance text-dim">
				Linux · Windows · macOS · Android — free, GPL-3.0.
			</p>
		</div>
		<figure class="min-w-0 md:col-span-5">
			<img
				src="/img/screenshot-home.png"
				alt="Home — saved playlists from Spotify and YouTube"
				width="1119"
				height="1011"
				class="w-full rounded-xl border border-zinc-800 bg-paper"
			/>
		</figure>
	</div>
</section>
