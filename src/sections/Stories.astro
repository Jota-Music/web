---
import { Download, Instagram } from "lucide-astro";
import type { Landing } from "@/i18n/landing/schema";
import type { Locale } from "@/i18n";

interface Props {
	t: Landing;
	locale: Locale;
}

const { t, locale } = Astro.props;
---

<section id="stories" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto grid w-full max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-12 md:items-center">
		<div class="min-w-0 md:col-span-6">
			<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">{t.stories.eyebrow}</p>
			<h1 class="mt-3 max-w-xl text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
				{t.stories.title}
			</h1>
			<p class="mt-4 max-w-xl text-sm leading-relaxed text-balance text-muted">
				{t.stories.body}
			</p>
			<div class="mt-8 flex flex-wrap items-center gap-3" data-actions>
				<button
					type="button"
					data-download
					disabled
					class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accent-ink transition-transform hover:-translate-y-px disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0"
				>
					<Download size={16} aria-hidden="true" />
					{t.stories.download}
				</button>
			</div>
			<p class="mt-4 text-xs text-balance text-dim" data-hint>{t.stories.hint}</p>
			<div class="mt-6 hidden rounded-2xl border border-accent/30 bg-surface/60 p-5 sm:p-6" data-after>
				<div class="flex items-start gap-3">
					<span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent">
						<Instagram size={18} aria-hidden="true" />
					</span>
					<div class="min-w-0">
						<p class="text-sm font-semibold text-ink">{t.stories.instructions}</p>
						<p class="mt-1 text-xs leading-relaxed text-muted">{t.stories.hint}</p>
					</div>
				</div>
			</div>
		</div>

		<div class="min-w-0 md:col-span-6">
			<canvas
				data-stories
				data-locale={locale}
				data-title={t.hero.title}
				data-body={t.hero.body}
				data-promises={Object.values(t.hero.promises).join("|")}
				width="1080"
				height="1920"
				role="img"
				aria-label={t.stories.title}
				class="mx-auto block h-auto w-full max-w-[320px] rounded-xl border border-zinc-800 bg-paper"
			>
			</canvas>
		</div>
	</div>
</section>

<script>
	const SANS = 'ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif';
	const PAPER = "#09090b";
	const INK = "#fafafa";
	const MUTED = "#a1a1aa";
	const SURFACE = "#18181b";
	const EDGE = "#27272a";

	const canvas = document.querySelector("[data-stories]");
	const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;

	if (canvas instanceof HTMLCanvasElement && ctx) {
		const { width: W, height: H } = canvas;
		const name = `jota-stories-${canvas.dataset.locale ?? "en"}.png`;
		const section = canvas.closest("section");
		const saveButton = section?.querySelector<HTMLButtonElement>("[data-download]");
		const actions = section?.querySelector<HTMLElement>("[data-actions]");
		const hint = section?.querySelector<HTMLElement>("[data-hint]");
		const after = section?.querySelector<HTMLElement>("[data-after]");

		const accent =
			getComputedStyle(document.documentElement).getPropertyValue("--color-accent").trim() ||
			"#ff6dd6";

		const rgba = (hex: string, alpha: number) => {
			const n = Number.parseInt(hex.slice(1), 16);
			return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
		};

		const font = (weight: number, size: number) => `${weight} ${size}px ${SANS}`;

		const round = (x: number, y: number, w: number, h: number, r: number) => {
			ctx.beginPath();
			ctx.roundRect(x, y, w, h, r);
		};

		const wrap = (text: string, max: number) => {
			const lines: string[] = [];
			let line = "";

			for (const word of text.split(/\s+/)) {
				const next = line ? `${line} ${word}` : word;

				if (line && ctx.measureText(next).width > max) {
					lines.push(line);
					line = word;
				} else {
					line = next;
				}
			}

			if (line) lines.push(line);

			if (import.meta.env.DEV) {
				for (const wrapped of lines) {
					console.assert(ctx.measureText(wrapped).width <= max, "stories: line overflows", wrapped);
				}
			}

			return lines;
		};

		const load = (src: string) =>
			new Promise<HTMLImageElement | null>((resolve) => {
				const image = new Image();
				image.onload = () => resolve(image);
				image.onerror = () => resolve(null);
				image.src = src;
			});

		const draw = async () => {
			const [icon, shot] = await Promise.all([
				load("/apple-touch-icon.png"),
				load("/img/screenshot-home.png"),
			]);

			await document.fonts.ready;

			const left = 96;
			const right = W - 96;
			const max = right - left;
			const top = 260;
			const bottom = 1680;

			ctx.fillStyle = PAPER;
			ctx.fillRect(0, 0, W, H);

			const bloom = ctx.createRadialGradient(W / 2, 0, 0, W / 2, 0, 1100);
			bloom.addColorStop(0, rgba(accent, 0.3));
			bloom.addColorStop(1, rgba(accent, 0));
			ctx.fillStyle = bloom;
			ctx.fillRect(0, 0, W, 1100);

			ctx.textAlign = "left";
			ctx.textBaseline = "top";

			let y = top;

			if (icon) {
				round(left, y, 112, 112, 28);
				ctx.save();
				ctx.clip();
				ctx.drawImage(icon, left, y, 112, 112);
				ctx.restore();
			}
			y += 164;

			ctx.font = font(700, 120);
			ctx.fillStyle = INK;
			ctx.fillText("Jota", left, y);
			y += 152;

			ctx.fillStyle = accent;
			ctx.fillRect(left, y, 128, 10);
			y += 46;

			ctx.font = font(700, 56);
			ctx.fillStyle = INK;
			for (const line of wrap(canvas.dataset.title ?? "", max)) {
				ctx.fillText(line, left, y);
				y += 68;
			}
			y += 16;

			ctx.font = font(400, 38);
			ctx.fillStyle = MUTED;
			for (const line of wrap(canvas.dataset.body ?? "", max)) {
				ctx.fillText(line, left, y);
				y += 50;
			}
			y += 44;

			ctx.font = font(600, 32);
			const pill = 68;
			const gap = 14;
			const col = (max - gap) / 2;
			const labels = (canvas.dataset.promises ?? "").split("|");
			let x = left;
			let i = 0;

			for (const label of labels) {
				const width = col;

				if (i > 0 && i % 2 === 0) {
					x = left;
					y += pill + gap;
				}

				round(x, y, width, pill, pill / 2);
				ctx.fillStyle = SURFACE;
				ctx.fill();
				ctx.strokeStyle = EDGE;
				ctx.lineWidth = 2;
				ctx.stroke();

				ctx.fillStyle = "#d4d4d8";
				ctx.textAlign = "center";
				ctx.textBaseline = "middle";
				ctx.fillText(label, x + width / 2, y + pill / 2, width - 24);
				ctx.textAlign = "left";
				ctx.textBaseline = "top";

				x += width + gap;
				i += 1;
			}
			y += pill + 44;

			ctx.font = font(600, 30);
			const text = "LINK AQUÍ";
			const textW = ctx.measureText(text).width;
			const boxW = textW + 48;
			const boxH = 120;
			const boxY = y + 24;

			ctx.setLineDash([12, 10]);
			ctx.strokeStyle = MUTED;
			ctx.lineWidth = 2;
			round(left, boxY, boxW, boxH, 16);
			ctx.stroke();
			ctx.setLineDash([]);

			ctx.fillStyle = MUTED;
			ctx.textAlign = "left";
			ctx.textBaseline = "middle";
			ctx.fillText(text, left + 24, boxY + boxH / 2);

			const shotY = boxY + boxH + 40;
			const height = Math.max(bottom - shotY, 0);

			if (shot) {
				const crop = (shot.width * height) / max;

				round(left, shotY, max, height, 28);
				ctx.save();
				ctx.clip();
				ctx.drawImage(shot, 0, 0, shot.width, crop, left, shotY, max, height);
				ctx.restore();

				round(left, shotY, max, height, 28);
				ctx.strokeStyle = EDGE;
				ctx.lineWidth = 2;
				ctx.stroke();
			}
		};

		const blob = () => new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/png"));

		const save = async () => {
			const data = await blob();
			if (!data) return;

			const url = URL.createObjectURL(data);
			const link = document.createElement("a");
			link.href = url;
			link.download = name;
			link.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		};

		const finish = () => {
			after?.classList.remove("hidden");
			if (hint) hint.textContent = "";
		};

		saveButton?.addEventListener("click", async () => {
			await save();
			finish();
		});

		await draw();

		if (saveButton) saveButton.disabled = false;
	}
</script>
