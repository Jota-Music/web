---
import { Copy, Download, Instagram } from "lucide-astro";
import type { Landing } from "@/i18n/landing/schema";
import { path, type Locale } from "@/i18n";

interface Props {
	t: Landing;
	locale: Locale;
	heading?: "h1" | "h2";
}

const { t, locale, heading = "h2" } = Astro.props;

const Heading = heading;

const share = new URL(
	path(locale),
	Astro.site ?? "https://jota.salvadorsru.com",
).toString();
---

<section id="stories" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto grid w-full max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-12 md:items-center">
		<div class="min-w-0 md:col-span-6">
			<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">{t.stories.eyebrow}</p>
			<Heading class="mt-3 max-w-xl text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
				{t.stories.title}
			</Heading>
			<p class="mt-4 max-w-xl text-sm leading-relaxed text-balance text-muted">
				{t.stories.body}
			</p>
			<p class="mt-6 max-w-xl text-sm leading-relaxed text-balance text-muted">
				{t.stories.intro}
			</p>
			<div class="mt-8 overflow-hidden rounded-2xl border border-accent/30 bg-gradient-to-br from-surface/80 to-paper">
				<div class="flex items-center gap-3 border-b border-white/5 px-5 py-4 sm:px-6">
					<span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent">
						<Instagram size={18} aria-hidden="true" />
					</span>
					<p class="text-sm font-semibold text-ink">{t.stories.instructions}</p>
				</div>
				<ol class="grid gap-3 px-5 py-4 text-sm text-muted sm:px-6">
					<li class="flex flex-wrap items-center gap-3">
						<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">1</span>
						<span class="text-ink">{t.stories.step1}</span>
						<button
							type="button"
							data-copy
							data-copy-url={share}
							data-copied={t.stories.copied}
							class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full border border-white/10 bg-surface px-4 text-sm font-semibold text-zinc-200 transition-colors hover:bg-raised"
						>
							<Copy size={14} aria-hidden="true" />
							<span data-copy-label aria-live="polite">{t.stories.copy}</span>
						</button>
					</li>
					<li class="flex flex-wrap items-center gap-3">
						<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">2</span>
						<span class="text-ink">{t.stories.step2}</span>
						<a
							href={`/stories-${locale}.png`}
							download={`jota-stories-${locale}.png`}
							data-download
							class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-full bg-accent px-4 text-sm font-semibold text-accent-ink transition-transform hover:-translate-y-px"
						>
							<Download size={14} aria-hidden="true" />
							{t.stories.download}
						</a>
					</li>
					<li class="flex items-start gap-3">
						<span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-accent/15 text-xs font-bold text-accent">3</span>
						<span class="text-ink">{t.stories.step3}</span>
					</li>
				</ol>
			</div>
		</div>

		<div class="min-w-0 md:col-span-6">
			<img
				src={`/stories-${locale}.png`}
				alt={t.stories.title}
				width="1080"
				height="1920"
				class="mx-auto block h-auto w-full max-w-[320px] rounded-xl border border-zinc-800 bg-paper"
			/>
		</div>
	</div>
</section>

<script>
	document.addEventListener("astro:page-load", () => {
		const copyButton = document.querySelector<HTMLButtonElement>("[data-copy]");
		copyButton?.addEventListener("click", async () => {
			try {
				await navigator.clipboard.writeText(copyButton.dataset.copyUrl ?? window.location.href);
				const label = copyButton.querySelector<HTMLElement>("[data-copy-label]");
				if (!label) return;
				const original = label.textContent;
				label.textContent = copyButton.dataset.copied ?? "Copied";
				setTimeout(() => (label.textContent = original), 2000);
			} catch {}
		});

		const downloadLink = document.querySelector<HTMLAnchorElement>("[data-download]");
		downloadLink?.addEventListener("click", async (event) => {
			event.preventDefault();
			const href = downloadLink.getAttribute("href");
			if (!href) return;
			try {
				const response = await fetch(href);
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				const url = URL.createObjectURL(await response.blob());
				const anchor = document.createElement("a");
				anchor.href = url;
				anchor.download = downloadLink.getAttribute("download") ?? "";
				document.body.append(anchor);
				anchor.click();
				anchor.remove();
				setTimeout(() => URL.revokeObjectURL(url), 1000);
			} catch {
				window.location.href = href;
			}
		});
	});
</script>
