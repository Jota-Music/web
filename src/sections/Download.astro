---
import { Apple, Download, Monitor, ShieldCheck, Smartphone, Terminal, TriangleAlert } from "lucide-astro";
import Phrase from "@/i18n/Phrase.astro";
import type { Landing } from "@/i18n/landing/schema";

interface Props {
	t: Landing;
}

const { t } = Astro.props;

const base = "https://github.com/Jota-Music/jota/releases/latest/download";

const rows = [
	{ icon: Terminal, key: "linux" },
	{ icon: Smartphone, key: "android" },
	{ icon: Monitor, key: "windows" },
	{ icon: Apple, key: "macos" },
] as const;

const links = {
	sums: `${base}/SHA256SUMS`,
	releases: "https://github.com/Jota-Music/jota/releases",
};
---

<section id="download" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">{t.download.eyebrow}</p>
		<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
			{t.download.title}
		</h2>
		<p class="mt-4 max-w-xl text-sm leading-relaxed text-balance text-muted">
			<Phrase value={t.download.body} />
		</p>

		<ul class="mt-8 border-t border-zinc-800 sm:grid sm:grid-cols-[max-content_1fr_max-content]">
			{
				rows.map(({ icon: Icon, key }) => (
					<li class="grid gap-y-2 border-b border-zinc-800 py-4 sm:col-span-3 sm:grid-cols-subgrid sm:items-center sm:gap-x-4">
						<span class="flex items-center gap-2.5 text-sm font-semibold text-ink">
							<Icon size={16} aria-hidden="true" class="text-accent" />
							{t.download.rows[key].platform}
						</span>
						<ul class="flex min-w-0 flex-wrap items-center gap-2">
							{Object.entries(t.download.rows[key].artifacts).map(([file, label]) => (
								<li>
									<a
										href={`${base}/${file}`}
										class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-zinc-700 px-3 py-1.5 text-sm text-zinc-200 transition-colors hover:border-accent hover:text-ink"
									>
										<Download size={13} aria-hidden="true" />
										{label}
									</a>
								</li>
							))}
						</ul>
						<span class="text-xs text-dim sm:text-right">{t.download.rows[key].note}</span>
					</li>
				))
			}
		</ul>

		<div class="mt-6 rounded-2xl border border-amber-500/30 bg-amber-500/5 p-5 sm:p-6">
			<div class="flex items-start gap-3">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-amber-500/30 bg-amber-500/10 text-amber-400">
					<TriangleAlert size={18} aria-hidden="true" />
				</span>
				<p class="text-sm leading-relaxed text-muted">
					<Phrase value={t.download.warning} />
				</p>
			</div>
		</div>

		<p class="mt-6 text-xs leading-relaxed text-balance text-dim">
			<Phrase
				value={t.download.legal}
				links={links}
				code="text-zinc-400"
				link="inline-flex items-center gap-1 text-zinc-300 underline decoration-zinc-700 underline-offset-4 transition-colors hover:text-ink"
				arrows={["releases"]}
			/>
		</p>
	</div>
</section>
