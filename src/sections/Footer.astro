---
import { Github } from "lucide-astro";
import Phrase from "@/i18n/Phrase.astro";
import type { Landing } from "@/i18n/landing/schema";

interface Props {
	t: Landing;
}

const { t } = Astro.props;

const links = [
	{ href: "https://github.com/Jota-Music/jota", label: t.footer.links.github },
	{ href: "https://github.com/Jota-Music/jota/releases", label: t.footer.links.releases },
	{ href: "https://github.com/Jota-Music/relay", label: t.footer.links.relay },
	{
		href: "https://github.com/Jota-Music/jota/wiki/Cloudflare-WARP",
		label: t.footer.links.warp,
	},
];

const credit = {
	author: "https://github.com/salvadorsru",
	license: "https://github.com/Jota-Music/jota/blob/main/LICENSE",
};
---

<footer class="border-t border-zinc-800 pt-16 pb-12 md:pt-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-4xl font-bold tracking-tight text-balance wrap-anywhere sm:text-5xl lg:text-6xl">
			{t.footer.headline.map((line, index) => (
				<>
					{index > 0 && <br />}
					{line}
				</>
			))}
		</p>

		<div
			class="mt-12 flex flex-col gap-6 border-t border-zinc-800 pt-6 sm:flex-row sm:items-center sm:justify-between"
		>
			<a href="#top" class="flex items-center gap-2 text-sm font-semibold text-ink">
				<img src="/apple-touch-icon.png" alt="" width="20" height="20" class="rounded-md" />
				Jota
			</a>
			<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								rel="noreferrer"
								class="text-sm text-muted transition-colors hover:text-ink"
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li>
					<a
						href="https://github.com/Jota-Music/jota"
						rel="noreferrer"
						aria-label={t.footer.github}
						class="flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-ink"
					>
						<Github size={15} aria-hidden="true" />
					</a>
				</li>
			</ul>
		</div>

		<p class="mt-6 max-w-3xl text-xs leading-relaxed text-balance text-dim">{t.footer.notice}</p>
		<p class="mt-3 text-xs text-balance text-dim">
			<Phrase
				value={t.footer.credit}
				links={credit}
				link="text-zinc-400 underline decoration-zinc-700 underline-offset-4 transition-colors hover:text-ink"
			/>
		</p>
	</div>
</footer>
