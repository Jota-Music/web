---
import { HelpCircle } from "lucide-astro";
import Phrase from "@/i18n/Phrase.astro";
import type { Landing } from "@/i18n/landing/schema";

interface Props {
	t: Landing;
}

const { t } = Astro.props;

const links = {
	wiki: "https://github.com/Jota-Music/jota/wiki",
	issues: "https://github.com/Jota-Music/jota/issues",
};
---

<section id="faq" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">{t.faq.eyebrow}</p>
		<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
			{t.faq.title}
		</h2>

		<dl class="mt-10 space-y-6" aria-label={t.faq.label}>
			{
				t.faq.items.map(({ q, a }) => (
					<div class="border-t border-zinc-800 pt-6 first:border-0">
						<dt class="text-sm font-semibold text-ink flex items-center gap-2">
							<HelpCircle size={16} aria-hidden="true" class="text-accent shrink-0" />
							{q}
						</dt>
						<dd class="mt-2 text-sm leading-relaxed text-balance text-muted">{a}</dd>
					</div>
				))
			}
		</dl>

		<p class="mt-8 text-xs text-dim">
			<Phrase
				value={t.faq.more}
				links={links}
				link="inline-flex items-center gap-1 text-zinc-300 underline decoration-zinc-700 underline-offset-4 transition-colors hover:text-ink"
				arrows={["wiki", "issues"]}
			/>
		</p>
	</div>
</section>
