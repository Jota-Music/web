---
import { ArrowRight, CloudOff, CreditCard, EyeOff } from "lucide-astro";

const points = [
	{
		icon: CloudOff,
		title: "No cloud",
		body: "Jota runs on your device. Your library, settings and history never leave it.",
	},
	{
		icon: EyeOff,
		title: "No tracking",
		body: "No analytics, no telemetry, no accounts. The only network calls are to the sources you chose.",
	},
	{
		icon: CreditCard,
		title: "No subscriptions",
		body: "No paid tier. GPL-3.0 — read the code, build it yourself, fork it if you want.",
	},
];
---

<section id="open-source" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">
			Open source
		</p>
		<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight [overflow-wrap:anywhere] sm:text-4xl">
			No cloud. No tracking. No subscriptions.
		</h2>

		<div
			class="mt-10 grid grid-cols-1 divide-y divide-zinc-800 border-y border-zinc-800 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
		>
			{
				points.map(({ icon: Icon, title, body }) => (
					<div class="min-w-0 px-0 py-6 sm:px-6 sm:first:pl-0 sm:last:pr-0">
						<Icon size={20} aria-hidden="true" class="text-accent" />
						<h3 class="mt-3 text-sm font-semibold text-ink">{title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-balance text-muted">{body}</p>
					</div>
				))
			}
		</div>

		<p class="mt-5 text-xs text-balance text-dim">
			Jota is GPL-3.0. Source is on <a
				href="https://github.com/Jota-Music/jota"
				rel="noreferrer"
				class="inline-flex items-center gap-1 text-zinc-300 underline decoration-zinc-700 underline-offset-4 transition-colors hover:text-ink"
				>GitHub<ArrowRight size={12} aria-hidden="true" /></a
			>.
		</p>
	</div>
</section>
