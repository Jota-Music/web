---
import { ArrowRight, Github, Radio } from "lucide-astro";

const shots = [
	{
		src: "/img/screenshot-search.png",
		alt: "Search across Spotify and YouTube",
		label: "Search",
		title: "One search bar, two sources.",
		body: "Type a song, an artist or paste a link — results from Spotify and YouTube land in the same list, ready to play from the same queue.",
	},
	{
		src: "/img/screenshot-rooms.png",
		alt: "Rooms — sync queue and play/pause across devices",
		label: "Rooms",
		title: "Listen together, over your own relay.",
		body: "Save a room, see who is listening, and sync queue, play/pause, position, shuffle and repeat across devices — through a WebSocket relay you host yourself.",
	},
];
---

<section id="tour" class="scroll-mt-28 py-16 md:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">In use</p>
		<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight [overflow-wrap:anywhere] sm:text-4xl">
			Open it, search, press play.
		</h2>

		<div class="mt-10 flex flex-col gap-14">
			{
				shots.map((shot) => (
					<figure class="min-w-0" data-reveal>
						<figcaption class="flex flex-col gap-2 border-b border-zinc-800 pb-4 sm:flex-row sm:items-end sm:justify-between">
							<div class="min-w-0">
								<p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">
									{shot.label}
								</p>
								<h3 class="mt-2 text-xl font-semibold tracking-tight text-ink sm:text-2xl">
									{shot.title}
								</h3>
							</div>
							<p class="max-w-md text-sm leading-relaxed text-balance text-muted sm:text-right">
								{shot.body}
							</p>
						</figcaption>
						<img
							src={shot.src}
							alt={shot.alt}
							width="1119"
							height="1011"
							loading="lazy"
							class="mt-5 w-full rounded-xl border border-zinc-800 bg-paper"
						/>
					</figure>
				))
			}
		</div>

		<div class="mt-8 rounded-xl border border-zinc-800 bg-surface/50 p-5 sm:p-6">
			<div class="flex min-w-0 items-start gap-3">
				<span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent">
					<Radio size={18} aria-hidden="true" />
				</span>
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-ink">Rooms run on your relay</h3>
					<p class="mt-1 max-w-2xl text-sm leading-relaxed text-balance text-muted">
						Syncing is the only part of Jota that talks to a server — and that
						server is yours. The relay lives in its own repo: one Go binary or
						the published Docker image, then point Jota at your own <code
							class="text-zinc-300">wss://</code
						> URL.
					</p>
				</div>
			</div>

			<dl class="mt-5 grid gap-5 border-t border-zinc-800 pt-5 sm:grid-cols-3">
				<div class="min-w-0">
					<dt class="text-sm font-semibold text-ink">Join by code</dt>
					<dd class="mt-1 text-sm leading-relaxed text-muted">
						The host shares a short room code and anyone holding it joins.
						Set a room password too if the code gets passed around.
					</dd>
				</div>
				<div class="min-w-0">
					<dt class="text-sm font-semibold text-ink">Late joiners catch up</dt>
					<dd class="mt-1 text-sm leading-relaxed text-muted">
						The relay caches the last playback state and syncs clocks, so a
						reconnect or a new device lands on the same beat instead of
						starting cold.
					</dd>
				</div>
				<div class="min-w-0">
					<dt class="text-sm font-semibold text-ink">Tune it or lock it</dt>
					<dd class="mt-1 text-sm leading-relaxed text-muted">
						Environment variables for the guest cap, room lifetime and play
						lead. <code class="text-zinc-300">AUTH_TOKEN</code> keeps the socket
						private; put Caddy or nginx in front for TLS.
					</dd>
				</div>
			</dl>

			<a
				href="https://github.com/Jota-Music/relay"
				rel="noreferrer"
				class="mt-5 inline-flex min-h-11 items-center gap-1.5 rounded-full border border-white/10 bg-paper px-4 py-2 text-sm font-medium text-zinc-200 transition-colors hover:bg-raised"
			>
				<Github size={15} aria-hidden="true" />
				Jota-Music/relay
			</a>
		</div>

		<div
			class="sticky bottom-4 z-40 mx-auto mt-10 w-fit flex justify-center sm:bottom-6"
		>
			<a
				href="#download"
				class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-accent-ink shadow-lg shadow-black/50 transition-transform hover:-translate-y-px"
			>
				Try it — download Jota
				<ArrowRight size={16} aria-hidden="true" />
			</a>
		</div>
	</div>
</section>

<script>
	if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
		const items = document.querySelectorAll("[data-reveal]");
		items.forEach((item) => item.classList.add("reveal"));
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-in");
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: "0px 0px -10% 0px" },
		);
		items.forEach((item) => observer.observe(item));
	}
</script>

<style>
	.reveal {
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease;
	}

	.reveal.is-in {
		opacity: 1;
		transform: none;
	}
</style>
