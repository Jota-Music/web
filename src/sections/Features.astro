---
import {
	CloudOff,
	Disc3,
	Headphones,
	Languages,
	ListMusic,
	ListPlus,
	Monitor,
	Play,
	Radio,
	RefreshCw,
	Shuffle,
	ShieldCheck,
	UserPlus,
	Users,
} from "lucide-astro";
import type { Landing } from "@/i18n/landing/schema";

interface Props {
	t: Landing;
}

const { t } = Astro.props;

const also = [
	{ icon: Monitor, key: "crossPlatform" },
	{ icon: RefreshCw, key: "updates" },
	{ icon: Languages, key: "languages" },
	{ icon: ListPlus, key: "playlists" },
	{ icon: UserPlus, key: "following" },
	{ icon: CloudOff, key: "local" },
] as const;
---

<section id="features" class="scroll-mt-28 py-12 md:py-24">
	<div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
		<p class="text-xs font-medium tracking-[0.18em] text-dim uppercase">
			{t.features.eyebrow}
		</p>
		<h2 class="mt-3 max-w-2xl text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
			{t.features.title}
		</h2>

		<div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6">
			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 sm:col-span-2 lg:col-span-4"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Disc3 size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">
					{t.features.cards.sources.title}
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.sources.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 lg:col-span-2"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Radio size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">{t.features.cards.radio.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.radio.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 lg:col-span-2"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<ListMusic size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">{t.features.cards.spotify.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.spotify.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 lg:col-span-4"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Play size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">
					{t.features.cards.youtube.title}
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.youtube.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 lg:col-span-2"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Shuffle size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">{t.features.cards.player.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.player.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 sm:col-span-2 lg:col-span-4"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Users size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">{t.features.cards.rooms.title}</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.rooms.body}
				</p>
			</article>

			<article
				class="min-w-0 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 sm:col-span-2 lg:col-span-2"
			>
				<span
					class="flex size-9 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<Headphones size={18} aria-hidden="true" />
				</span>
				<h3 class="mt-4 text-sm font-semibold text-ink">
					{t.features.cards.media.title}
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-balance text-muted">
					{t.features.cards.media.body}
				</p>
			</article>

			<article
				class="flex min-w-0 flex-col gap-4 rounded-xl border border-zinc-800 bg-surface/50 p-5 transition-colors hover:border-zinc-700 sm:col-span-2 sm:flex-row sm:items-center lg:col-span-4"
			>
				<span
					class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-accent/30 bg-accent/10 text-accent"
				>
					<ShieldCheck size={18} aria-hidden="true" />
				</span>
				<div class="min-w-0">
					<h3 class="text-sm font-semibold text-ink">{t.features.cards.privacy.title}</h3>
					<p class="mt-1 text-sm leading-relaxed text-balance text-muted">
						{t.features.cards.privacy.body}
					</p>
				</div>
			</article>
		</div>

		<ul class="mt-6 flex flex-wrap gap-2">
			{
				also.map(({ icon: Icon, key }) => (
					<li class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-surface/50 px-3 py-1.5 text-xs text-zinc-300">
						<Icon size={13} aria-hidden="true" class="text-dim" />
						{t.features.also[key]}
					</li>
				))
			}
		</ul>
	</div>
</section>
