---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import { landing, locales, match, path, defaultLocale, type Locale } from "@/i18n";

const locale = match(Astro.url.pathname);
const { meta } = await landing(locale);
const { title, description } = meta;

const og: Record<Locale, string> = { en: "en_US", es: "es_ES" };
const alternates = [
	...locales.map((code) => ({ hreflang: code, href: path(code) })),
	{ hreflang: "x-default", href: path(defaultLocale) },
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<style is:inline>html{background-color:#09090b}</style>
		<link rel="icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#09090b" />
		{
			alternates.map((alternate) => (
				<link rel="alternate" hreflang={alternate.hreflang} href={new URL(alternate.href, Astro.site)} />
			))
		}
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={og[locale]} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("/img/banner.png", Astro.site)} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL("/img/banner.png", Astro.site)} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="antialiased">
		<slot />
		<Analytics />
	</body>
</html>
